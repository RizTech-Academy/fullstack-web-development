NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://kirana:localdev@localhost:5432/kirana
JWT_SECRET=generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000

# The gateway signs every webhook with this. Generate one with:
#   openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET=generate-with-openssl-rand-base64-32
# Sent to the browser. Identifies the shop; authorises nothing.
PAYMENT_PUBLIC_KEY=kirana_test_key
